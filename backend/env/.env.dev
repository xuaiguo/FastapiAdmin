# ==================================
# 开发环境配置文件（案例）
# ==================================

ENVIRONMENT = dev

# 服务器配置
SERVER_HOST = localhost
SERVER_PORT = 8001

# 文档配置
DEBUG = True
VERSION = 3.0.0

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置：mysql-3306、postgres-5432、sqlite
DATABASE_TYPE = mysql
DATABASE_HOST = 10.3.94.10
DATABASE_PORT = 3306
DATABASE_USER = root
DATABASE_PASSWORD = fastapiadmin_root
DATABASE_NAME = fastapiadmin_dev3

# Redis配置
REDIS_HOST = 10.3.94.10
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = fastapiadmin_redis
REDIS_DB_NAME = 3

# 日志级别配置
LOGGER_LEVEL = DEBUG

# 大模型配置
OPENAI_BASE_URL = https://api.deepseek.com
OPENAI_API_KEY = your_api_key
OPENAI_MODEL = deepseek-v4-flash
